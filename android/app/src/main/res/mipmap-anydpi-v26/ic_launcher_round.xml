<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8+ adaptive icon. The foreground keeps the `< >` mark inside the
  72dp safe zone, so no launcher mask clips it. The monochrome layer is what
  Android 13+ themed icons tint, and the system reads only its alpha.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
