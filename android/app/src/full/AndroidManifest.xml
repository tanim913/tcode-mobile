<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      "All files access" for the `full` (direct APK) flavour only.

      This permission is opt-in inside the app: it is requested from a screen
      that explains what it is for, and the app works fully without it by using
      the Storage Access Framework instead. Granting it switches those paths to
      the faster dart:io provider.

      Google Play restricts MANAGE_EXTERNAL_STORAGE to a small set of app
      categories that a code editor does not belong to, which is exactly why it
      is declared here and not in the shared manifest.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Network, for downloading a public repository as a branch ZIP.

      Declared here and NOT in the shared manifest so the Play build keeps its
      zero-permission property: it cannot reach the network even in principle,
      which is what lets the rest of the app tell the user it has no network
      access and be telling the truth.

      The `full` build is the one that can download; every offline claim in the
      UI is gated on `RepoDownload.isAvailable` rather than being hardcoded.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:requestLegacyExternalStorage="true" />
</manifest>
